{
  "name": "ewlat-motion",
  "private": true,
  "version": "1.0.0",
  "description": "ewlat.org animasyon ve etkileşim katmanı (Tailwind CSS)",
  "scripts": {
    "build": "tailwindcss -i ./src/motion.css -o ./assets/css/motion.css --minify",
    "dev": "tailwindcss -i ./src/motion.css -o ./assets/css/motion.css --watch",
